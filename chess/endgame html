<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Decipher Chess Endgame Training Room</title>
    <link rel="stylesheet" href="https://unpkg.com/@chrisoakman/chessboardjs@1.0.0/dist/chessboard-1.0.0.min.css">
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
    <script src="https://unpkg.com/@chrisoakman/chessboardjs@1.0.0/dist/chessboard-1.0.0.min.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-firestore.js"></script>

    <style>
        body { margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; background: #0f172a; color: white; display: flex; flex-direction: column; align-items: center; overflow-x: hidden;}
        
        @keyframes bounceIn {
            0% { transform: scale(0.8); opacity: 0; }
            50% { transform: scale(1.05); opacity: 1; }
            70% { transform: scale(0.95); }
            100% { transform: scale(1); }
        }
        @keyframes pulseYellow {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        .bounce-anim { animation: bounceIn 0.8s ease-out forwards; }
        
        #welcome-overlay, #admin-overlay { position: absolute; width: 100%; min-height: 100vh; background: #0f172a; display: flex; flex-direction: column; align-items: center; z-index: 1000; padding: 20px 0; }
        #admin-overlay { display: none; z-index: 3000; }
        #matchmaking-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #0f172a; z-index: 1500; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
        
        .spinner-container { position: relative; width: 80px; height: 80px; margin-bottom: 25px; }
        .spinner { position: absolute; width: 100%; height: 100%; border: 6px solid transparent; border-top: 6px solid #005aab; border-bottom: 6px solid #4ade80; border-radius: 50%; animation: spin 1.2s cubic-bezier(0.68, -0.55, 0.265, 1.55) infinite; box-sizing: border-box; }
        .spinner-inner { position: absolute; top: 10px; left: 10px; width: calc(100% - 20px); height: calc(100% - 20px); border: 4px solid transparent; border-left: 4px solid #facc15; border-right: 4px solid #facc15; border-radius: 50%; animation: spin 0.8s linear infinite reverse; box-sizing: border-box; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        
        .waiting-text { font-size: 1.2em; color: #94a3b8; margin: 10px 0; min-height: 30px; transition: color 0.3s; }
        .loading-bar { width: 250px; height: 6px; background: #334155; border-radius: 3px; margin-top: 15px; overflow: hidden; position: relative; }
        .loading-progress { width: 0%; height: 100%; background: linear-gradient(90deg, #005aab, #4ade80); }
        
        #round-results-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.98); z-index: 2500; flex-direction: column; align-items: center; justify-content: center; text-align: center; overflow-y: auto; padding: 20px 0; }
        .login-card { background: #1e293b; padding: 25px; border-radius: 15px; border: 2px solid #005aab; width: 90%; max-width: 400px; text-align: center; margin-bottom: 25px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        .login-card input { width: 100%; padding: 12px; margin: 8px 0; border-radius: 5px; border: 1px solid #334155; background: #0f172a; color: white; box-sizing: border-box; font-size: 16px;}
        .rep-btn { background: #334155; color: white; padding: 12px; border: 1px solid #005aab; border-radius: 8px; cursor: pointer; width: 100%; margin: 5px 0; text-align: left; transition: 0.3s; font-size: 15px; font-weight: 500;}
        .rep-btn.selected { background: #005aab; border-color: #4ade80; box-shadow: 0 0 10px rgba(74, 222, 128, 0.3);}
        #game-container { display: none; width: 95vmin; max-width: 500px; padding: 20px 10px; }
        #board { width: 100%; border: 3px solid #005aab; border-radius: 8px; box-shadow: 0 5px 20px rgba(0,0,0,0.4); }
        .info-panel { background: #1e293b; padding: 15px; border-radius: 12px; border: 1px solid #005aab; text-align: center; box-shadow: 0 5px 15px rgba(0,0,0,0.3);}
        .submit-btn { background: #005aab; color: white; padding: 14px; border: none; border-radius: 8px; cursor: pointer; font-weight: bold; width: 100%; margin-top: 15px; font-size: 16px; transition: 0.2s;}
        .submit-btn:hover { background: #004280; transform: translateY(-2px); }
        .opp-card { display: flex; justify-content: space-between; align-items: center; background: #0f172a; padding: 12px; border-radius: 8px; margin-bottom: 10px; border-left: 4px solid #ef4444; }
        .timer-box { font-family: monospace; background: #000; padding: 8px 12px; border-radius: 6px; font-size: 1.3em; min-width: 80px; letter-spacing: 1px;}
        .highlight-white { background: rgba(0, 90, 171, 0.5) !important; }
        .instruction-text { color: #facc15; font-size: 0.85em; margin: 10px 0 15px 0; text-align: left; background: rgba(0,0,0,0.2); padding: 10px; border-radius: 5px; }
        
        .admin-log-item { background: #0f172a; padding: 10px; margin: 5px 0; border-radius: 5px; font-size: 0.85em; text-align: left; border: 1px solid #334155; position: relative; }
        .copy-icon { cursor: pointer; position: absolute; right: 10px; top: 10px; background: #005aab; color: white; border: none; border-radius: 4px; padding: 2px 6px; font-size: 10px; }
        
        .performance-table { width: 100%; margin-top: 15px; border-collapse: collapse; font-size: 0.85em; }
        .performance-table th { color: #94a3b8; padding-bottom: 8px; border-bottom: 1px solid #334155; }
        .performance-table td { padding: 8px 0; border-bottom: 1px solid #1e293b; }
    </style>
</head>
<body>

<!-- Admin Monitor -->
<div id="admin-overlay">
    <div class="login-card" style="max-width: 600px;">
        <h2 style="color: #facc15;">COACH'S LOBBY (LIVE VIEW)</h2>
        
        <h4 style="color:#4ade80; text-align:left; margin-bottom:5px;">🔴 Live Active Games</h4>
        <div id="live-admin-logs" style="max-height: 200px; overflow-y: auto; margin-bottom: 15px; border:1px solid #334155; padding:10px; background:#0f172a; border-radius:8px;">
            <p>No students playing right now...</p>
        </div>

        <h4 style="color:#005aab; text-align:left; margin-bottom:5px;">Completed Matches</h4>
        <div id="admin-logs" style="max-height: 200px; overflow-y: auto; margin-bottom: 15px;">
            <p>No games recorded yet...</p>
        </div>
        
        <button class="submit-btn" onclick="closeAdmin()">CLOSE MONITOR</button>
    </div>
</div>

<div id="round-results-overlay">
    <div class="login-card bounce-anim" style="margin-top: 20px; width: 95%;">
        <h1 id="res-status-text" style="color: #4ade80; margin-top: 0;">LEVEL <span id="res-round-num">1</span> COMPLETE</h1>
        <p id="res-sub-text" style="color: #94a3b8;">Proceeding...</p>
        
        <div style="background: #0f172a; padding: 15px; border-radius: 10px; margin: 15px 0;">
            <h4 style="margin: 0 0 10px 0; color: #005aab; text-align: left;">TRAINING PROGRESS</h4>
            <table class="performance-table" id="team-summary-body">
                <!-- Dynamically populated -->
            </table>
        </div>

        <button id="next-round-btn" class="submit-btn" onclick="startWaitingCountdown(true)">PROCEED TO NEXT LEVEL</button>
    </div>
</div>

<div id="matchmaking-overlay">
    <div class="spinner-container">
        <div class="spinner"></div>
        <div class="spinner-inner"></div>
    </div>
    <h2 class="waiting-text" id="loading-msg">Setting up the board...</h2>
    <div class="loading-bar"><div class="loading-progress" id="load-bar"></div></div>
</div>

<div id="welcome-overlay">
    <div class="login-card bounce-anim">
        <h1 style="color: #005aab; margin: 0; font-size: 2.2em; letter-spacing: 1px;">DECIPHER CHESS</h1>
        <h3 style="margin: 5px 0 5px 0; color: #94a3b8; font-weight: 500;">Endgame Training Room</h3>
        
        <div class="instruction-text">
            <b>RULES:</b><br>
            • Time Control is <b>3+2</b> (3 mins + 2 sec increment per move).<br>
            • You must WIN the endgame against the strongest Engine level to advance.<br>
            • If you draw, lose, or run out of time, you will <b>RESTART</b> the level.<br>
            • Positions are randomized. Stay sharp!
        </div>

        <div id="rep-list" style="margin-bottom: 20px; max-height: 250px; overflow-y: auto; padding-right: 5px;">
            <button class="rep-btn" onclick="selectRep(this, 'Onele Chierika')">Onele Chierika</button>
            <button class="rep-btn" onclick="selectRep(this, 'Semilore Beckley')">Semilore Beckley</button>
            <button class="rep-btn" onclick="selectRep(this, 'Andrew Nwagbale')">Andrew Nwagbale</button>
            <button class="rep-btn" onclick="selectRep(this, 'Ajayi Oluwaseun')">Ajayi Oluwaseun</button>
            <button class="rep-btn" onclick="selectRep(this, 'Obi Chukwuemeka')">Obi Chukwuemeka</button>
            <button class="rep-btn" onclick="selectRep(this, 'Eliana Lawrence')">Eliana Lawrence</button>
            <button class="rep-btn" onclick="selectRep(this, 'Sage Osafile')">Sage Osafile</button>
        </div>
        <input type="password" id="studentPass" placeholder="Enter Team Password">
        <button class="submit-btn" onclick="validateAndStart()">START TRAINING</button>
        <button style="margin-top:20px; background:transparent; border:none; color:#334155; font-size:0.7em; cursor:pointer;" onclick="openAdmin()">COACH MONITOR</button>
    </div>
</div>

<div id="game-container">
    <div class="info-panel bounce-anim">
        <div style="display:flex; justify-content: space-between; margin-bottom: 15px; font-size: 0.9em; color: #94a3b8; font-weight: bold;">
            <span id="round-header">LEVEL 1 / 4</span>
            <span style="color:#facc15">TIME: 3+2</span>
        </div>
        <div class="opp-card">
            <div style="text-align: left;"><b id="opp-name" style="color:#ef4444">Garbo Engine (Max)</b><br><small>Endgame Defender</small></div>
            <div id="opp-timer" class="timer-box">03:00</div>
        </div>
        <div id="board"></div>
        <div class="opp-card" style="border-left: 4px solid #4ade80; margin-top: 15px;">
            <div style="text-align: left;"><b id="displayName" style="color:#4ade80"></b><br><small>White Pieces</small></div>
            <div id="user-timer" class="timer-box">03:00</div>
        </div>
        <div id="status" style="font-weight: bold; margin: 15px 0; color: #facc15; font-size: 1.1em;">Waiting...</div>
        <button class="submit-btn" onclick="handleResign()" style="background: #ef4444; border: 1px solid #7f1d1d;">RESTART LEVEL</button>
    </div>
</div>

<script>
const chessWorker = new Worker('./chess-worker.js');
const firebaseConfig = { apiKey: "AIzaSyCcSVTifrJhzXvhQ4m1UyObtCKd8", authDomain: "assignments-de95a.firebaseapp.com", projectId: "assignments-de95a", storageBucket: "assignments-de95a.firebasestorage.app", messagingSenderId: "1088073398299", appId: "1:1088073398299:web:dab1f57ac1d63b10dba0be" };
if (!firebase.apps.length) { firebase.initializeApp(firebaseConfig); }
const db = firebase.firestore();

// Level configurations with multiple FEN options
const trainingLevels = [
    { 
        title: "Rook & King vs King", 
        fens: [
            "8/8/8/8/8/8/R7/4K1k1 w - - 0 1",
            "8/8/8/8/4K3/8/R7/7k w - - 0 1",
            "8/8/8/8/8/2K5/R7/1k6 w - - 0 1"
        ] 
    },
    { 
        title: "Queen & King vs King", 
        fens: [
            "8/8/8/8/8/8/Q7/4K1k1 w - - 0 1",
            "8/8/8/8/4K3/8/Q7/7k w - - 0 1",
            "8/8/8/8/8/2K5/Q7/1k6 w - - 0 1"
        ] 
    },
    { 
        title: "R, K & 4P vs R, K & 2P", 
        fens: [
            "r3k3/p6p/8/8/8/8/PP4PP/R3K3 w q - 0 1",
            "4k3/p6p/8/8/8/8/PP4PP/4K2R w K - 0 1",
            "4k2r/p6p/8/8/8/8/PP4PP/4K3 w k - 0 1"
        ] 
    },
    {
        title: "R, B & 5P vs R & 3P",
        fens: [
            "r3k3/pp5p/8/8/4B3/8/PP3PPP/4R1K1 w q - 0 1"
        ]
    }
];

const INITIAL_TIME = 180; // 3 minutes
const INCREMENT = 2; // 2 seconds

var currentLevel = 1, totalScore = 0, gameInProgress = false;
var game = new Chess(), board = null, selectedRepName = "";
var userTime = INITIAL_TIME, oppTime = INITIAL_TIME, timerInterval = null; 
var liveDocId = null;
var liveUnsubscribe = null;

function selectRep(btn, name) {
    $('.rep-btn').removeClass('selected');
    $(btn).addClass('selected');
    selectedRepName = name;
}

function validateAndStart() {
    if (!selectedRepName) return alert("Please select your name!");
    if ($('#studentPass').val() !== "decipherchess") return alert("Wrong Password!");
    $('#welcome-overlay').hide();
    runLoadingSequence();
}

function openAdmin() {
    let pass = prompt("Enter Coach Passcode:");
    if(pass === "decipher1234") {
        $('#admin-overlay').show();
        loadAdminLogs();
        startLiveTracking();
    } else {
        alert("Access Denied");
    }
}

function closeAdmin() {
    $('#admin-overlay').hide();
    if(liveUnsubscribe) liveUnsubscribe();
}

function copyPGN(pgn) {
    navigator.clipboard.writeText(pgn).then(() => alert("Game PGN copied to clipboard!"));
}

function loadAdminLogs() {
    db.collection("tournament_games").orderBy("timestamp", "desc").limit(20).get().then((querySnapshot) => {
        let html = "";
        querySnapshot.forEach((doc) => {
            let d = doc.data();
            let safePgn = d.pgn.replace(/'/g, "\\'").replace(/\n/g, " ");
            let colorStr = d.result.includes("Win") ? "#4ade80" : "#ef4444";
            html += `<div class="admin-log-item">
                        <button class="copy-icon" onclick="copyPGN('${safePgn}')">COPY PGN</button>
                        <b>${d.player} (Level ${d.round})</b><br>
                        Result: <span style="color:${colorStr}">${d.result}</span> | FEN/PGN Logged
                     </div>`;
        });
        $('#admin-logs').html(html || "No completed training sessions found.");
    });
}

function startLiveTracking() {
    liveUnsubscribe = db.collection("live_games").where("status", "==", "Playing").onSnapshot((snapshot) => {
        let html = "";
        snapshot.forEach((doc) => {
            let d = doc.data();
            html += `<div class="admin-log-item">
                        <b style="color:#facc15">${d.player}</b> is on Level ${d.level}<br>
                        <small style="color:#94a3b8; font-family:monospace;">FEN: ${d.fen}</small>
                     </div>`;
        });
        $('#live-admin-logs').html(html || "<p>No students playing right now...</p>");
    });
}

function saveGameToCloud(resultStatus) {
    db.collection("tournament_games").add({
        player: selectedRepName,
        round: currentLevel,
        pgn: game.pgn(),
        result: resultStatus,
        timestamp: firebase.firestore.FieldValue.serverTimestamp()
    });
    
    if (liveDocId) {
        db.collection("live_games").doc(liveDocId).update({ status: "Finished" });
    }
}

function updateLiveDB() {
    if (liveDocId) {
        db.collection("live_games").doc(liveDocId).update({
            fen: game.fen(),
            lastUpdate: firebase.firestore.FieldValue.serverTimestamp()
        });
    }
}

function runLoadingSequence() {
    $('#matchmaking-overlay').css('display', 'flex');
    $('#loading-msg').text("Loading Level " + currentLevel + "...");
    $('#load-bar').css('width', '0%').css('transition', 'none');
    
    setTimeout(() => { $('#load-bar').css('transition', `width 1500ms linear`).css('width', '100%'); }, 50);
    
    setTimeout(() => {
        setupMatch();
    }, 1500);
}

function handleResign() { 
    if(confirm("Restarting this level will score it as a failure. Continue?")) {
        endRound(0); 
    }
}

function endRound(points) {
    gameInProgress = false;
    clearInterval(timerInterval);
    
    let isWin = (points === 1);
    let resTxt = isWin ? "Checkmate (Win)" : (points === 0.5 ? "Draw / Stalemate" : "Failed / Timeout");
    saveGameToCloud(resTxt);
    
    $('#game-container').hide();
    $('#round-results-overlay').css('display', 'flex');
    
    let isFinal = isWin && (currentLevel >= 4);

    if (isWin) {
        $('#res-status-text').text("LEVEL " + currentLevel + " PASSED").css('color', '#4ade80');
        $('#res-sub-text').text("Excellent technique.");
        $('#next-round-btn').text(isFinal ? "TRAINING COMPLETE" : "PROCEED TO NEXT LEVEL")
                            .attr('onclick', `startWaitingCountdown(true)`)
                            .css('background', '#005aab');
    } else {
        $('#res-status-text').text("LEVEL " + currentLevel + " FAILED").css('color', '#ef4444');
        $('#res-sub-text').text("You must win to advance. Try again.");
        $('#next-round-btn').text("RESTART LEVEL")
                            .attr('onclick', `startWaitingCountdown(false)`)
                            .css('background', '#ef4444');
    }
    
    // Build summary table
    let html = `<tr><th align="left">LEVEL</th><th align="right">STATUS</th></tr>`;
    for(let i=1; i<=4; i++) {
        let statusText = "PENDING";
        let color = "#94a3b8";
        
        if (i < currentLevel) { statusText = "PASSED"; color = "#4ade80"; }
        else if (i === currentLevel) { 
            statusText = isWin ? "PASSED" : "FAILED"; 
            color = isWin ? "#4ade80" : "#ef4444"; 
        }
        
        html += `<tr><td>Level ${i}</td><td align="right" style="color:${color}; font-weight:bold;">${statusText}</td></tr>`;
    }
    $('#team-summary-body').html(html);
    
    if(isFinal) { $('#next-round-btn').css('background', '#4ade80').prop('disabled', true); }
}

function setupMatch() {
    gameInProgress = true;
    userTime = INITIAL_TIME; oppTime = INITIAL_TIME; 
    
    let currentScenario = trainingLevels[currentLevel - 1];
    // Pick a random FEN from the available array for this level
    let randomFen = currentScenario.fens[Math.floor(Math.random() * currentScenario.fens.length)];
    
    game = new Chess(randomFen);
    
    $('#displayName').text(selectedRepName);
    $('#round-header').text(`LEVEL ${currentLevel} / 4: ${currentScenario.title}`);
    $('#user-timer').text(formatTime(userTime));
    $('#opp-timer').text(formatTime(oppTime));
    $('#matchmaking-overlay').hide();
    $('#game-container').show();
    
    board = ChessBoard('board', {
        draggable: false, position: randomFen, orientation: 'white',
        pieceTheme: 'https://chessboardjs.com/img/chesspieces/wikipedia/{piece}.png'
    });
    
    timerInterval = setInterval(updateTimers, 1000);
    $('#status').text("Your turn (White)");

    db.collection("live_games").add({
        player: selectedRepName,
        level: currentLevel,
        fen: game.fen(),
        status: "Playing",
        timestamp: firebase.firestore.FieldValue.serverTimestamp()
    }).then(docRef => {
        liveDocId = docRef.id;
    });
}

chessWorker.onmessage = function(e) {
    if (typeof e.data === 'string' && e.data.length >= 4) {
        // Remove fake delay, execute as soon as worker responds
        game.move({ from: e.data.substring(0, 2), to: e.data.substring(2, 4), promotion: 'q' });
        board.position(game.fen());
        
        // Add increment
        oppTime += INCREMENT;
        $('#opp-timer').text(formatTime(oppTime));

        updateLiveDB();

        if (game.game_over()) {
            handleGameOver();
        } else {
            $('#status').text("Your turn!");
        }
    }
};

function startWaitingCountdown(didPass) {
    if(didPass && currentLevel >= 4) return;
    
    $('#round-results-overlay').hide();
    
    if(didPass) { currentLevel++; }
    
    runLoadingSequence();
}

function formatTime(s) {
    let min = Math.floor(s / 60), sec = s % 60;
    return (min < 10 ? '0' : '') + min + ":" + (sec < 10 ? '0' : '') + sec;
}

function handleGameOver() {
    if (game.in_checkmate()) {
        endRound(game.turn() === 'b' ? 1 : 0); // If black's turn and checkmate, white won
    } else {
        endRound(0.5); // Stalemate / draw / insufficient material
    }
}

function updateTimers() {
    if (game.game_over()) { return handleGameOver(); }
    
    if (game.turn() === 'w') {
        userTime--;
        $('#user-timer').text(formatTime(userTime));
        if (userTime <= 0) endRound(0); // Timeout = fail
    } else {
        oppTime--;
        $('#opp-timer').text(formatTime(oppTime));
        if (oppTime <= 0) endRound(1); // Opponent timeout = win
    }
}

function onSquareClick(sq) {
    if (!gameInProgress || game.game_over() || game.turn() !== 'w') return;
    let sourceSquare = window.srcSq;
    
    if (!sourceSquare) {
        let p = game.get(sq);
        if (p && p.color === 'w') { 
            window.srcSq = sq; 
            $('.square-' + sq).addClass('highlight-white'); 
        }
        return;
    }
    
    let move = game.move({ from: sourceSquare, to: sq, promotion: 'q' });
    $('.highlight-white').removeClass('highlight-white');
    window.srcSq = null;
    
    if (move) {
        board.position(game.fen());
        updateLiveDB(); 

        // Add Increment
        userTime += INCREMENT;
        $('#user-timer').text(formatTime(userTime));

        if (!game.game_over()) {
            $('#status').text("Engine is thinking...");
            chessWorker.postMessage("position " + game.fen());
            // Search 3000 to ensure Garbo plays at its strongest defensive level
            chessWorker.postMessage("search 3000"); 
        } else {
            handleGameOver();
        }
    }
}

$('#board').on('click', '[class*="square-"]', function() { onSquareClick($(this).attr('data-square')); });
</script>
</body>
</html>
